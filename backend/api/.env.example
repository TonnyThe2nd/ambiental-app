# Docker Compose already provides this value to the API container.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbaneye
RABBITMQ_URL=amqp://urbaneye:urbaneye@localhost:5672/
WORKER_PREFETCH=20
WORKER_MAX_RETRIES=5
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRE_MINUTES=60
# development mantém /docs disponível; production desliga a documentação e liga o HSTS.
ENV=development
# Origens autorizadas no CORS, separadas por vírgula (vazio = http://localhost:3000).
ALLOWED_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
# Tempo real (WebSocket): assina os eventos do RabbitMQ; false desliga o assinante.
REALTIME_ENABLED=true
CACHE_TTL_SECONDS=30
# Implantação gratuita: roda worker e outbox-poller dentro do processo da API.
EMBEDDED_WORKERS=false
# quorum (padrão) ou classic (use classic em RabbitMQ gerenciado gratuito, ex.: CloudAMQP).
RABBITMQ_QUEUE_TYPE=quorum
