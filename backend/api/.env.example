# Docker Compose already provides this value to the API container.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbaneye
RABBITMQ_URL=amqp://urbaneye:urbaneye@localhost:5672/
WORKER_PREFETCH=20
WORKER_MAX_RETRIES=5
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRE_MINUTES=60
# development mantém /docs disponível; production desliga a documentação e liga o HSTS.
ENV=development
# Origens autorizadas no CORS, separadas por vírgula (vazio = http://localhost:3000).
ALLOWED_ORIGINS=http://localhost:3000
